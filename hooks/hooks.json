{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "! command -v iwe >/dev/null 2>&1 || iwe internal claude hook session-start || [ $? -eq 2 ]",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "! command -v iwe >/dev/null 2>&1 || iwe internal claude hook post-tool 2>/dev/null || true",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
